{
  "name": "penko-writer",
  "private": true,
  "version": "1.0.0-alpha.1",
  "type": "module",
  "description": "A free, privacy-first word processor with features Microsoft Word and Google Docs don't have",
  "author": "Penko Team",
  "license": "GPL-3.0",
  "homepage": "https://github.com/NA-Ag/penko-writer",
  "bugs": {
    "url": "https://github.com/NA-Ag/penko-writer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NA-Ag/penko-writer.git"
  },
  "keywords": [
    "word-processor",
    "pwa",
    "react",
    "typescript",
    "offline-first",
    "privacy",
    "open-source",
    "rich-text-editor",
    "markdown",
    "screenplay"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:pages": "BASE_PATH=/penko-writer/ vite build",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "signaling": "y-webrtc-signaling",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-collaboration-caret": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/y-tiptap": "^3.0.9",
    "docx": "^9.5.1",
    "dompurify": "^3.4.16",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.27",
    "lucide-react": "^0.554.0",
    "mammoth": "^1.11.0",
    "marked": "^18.0.14",
    "prismjs": "^1.30.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.28"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.14.0",
    "@types/prismjs": "^1.26.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
